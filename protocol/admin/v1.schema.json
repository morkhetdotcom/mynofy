{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mynofy.local/protocol/admin/v1",
  "title": "mynofy local admin v1",
  "description": "Separate same-UID Unix socket; one JSON line per connection. Security mutations are journaled asynchronously; topic topology and policy changes affect RAM until explicitly saved or exported.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "clients_list": {
      "type": "object",
      "properties": {
        "op": {
          "const": "clients_list"
        },
        "after": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "client_get": {
      "type": "object",
      "properties": {
        "op": {
          "const": "client_get"
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "op",
        "client"
      ],
      "additionalProperties": false
    },
    "client_add": {
      "type": "object",
      "properties": {
        "op": {
          "const": "client_add"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "description": "Strict RFC3339 UTC with Z, future owner time."
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "public_key"
      ],
      "additionalProperties": false
    },
    "client_disable": {
      "type": "object",
      "properties": {
        "op": {
          "const": "client_disable"
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "client",
        "disabled"
      ],
      "additionalProperties": false
    },
    "key_add": {
      "type": "object",
      "properties": {
        "op": {
          "const": "key_add"
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "description": "Strict RFC3339 UTC with Z, future owner time."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "client",
        "public_key"
      ],
      "additionalProperties": false
    },
    "key_revoke": {
      "type": "object",
      "properties": {
        "op": {
          "const": "key_revoke"
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "token"
      ],
      "additionalProperties": false
    },
    "acl_get": {
      "type": "object",
      "properties": {
        "op": {
          "const": "acl_get"
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "op",
        "client",
        "topic"
      ],
      "additionalProperties": false
    },
    "acl_set": {
      "type": "object",
      "properties": {
        "op": {
          "const": "acl_set"
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allow": {
          "type": "array",
          "items": {
            "enum": [
              "publish",
              "subscribe",
              "inspect_own"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        }
      },
      "required": [
        "op",
        "client",
        "topic",
        "allow"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "op": {
          "const": "status"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "properties": {
        "op": {
          "const": "export"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "command": {
          "oneOf": [
            {
              "$ref": "#/$defs/clients_list"
            },
            {
              "$ref": "#/$defs/client_get"
            },
            {
              "$ref": "#/$defs/client_add"
            },
            {
              "$ref": "#/$defs/client_disable"
            },
            {
              "$ref": "#/$defs/key_add"
            },
            {
              "$ref": "#/$defs/key_revoke"
            },
            {
              "$ref": "#/$defs/acl_get"
            },
            {
              "$ref": "#/$defs/acl_set"
            },
            {
              "$ref": "#/$defs/status"
            },
            {
              "$ref": "#/$defs/export"
            },
            {
              "$ref": "#/$defs/content_save"
            },
            {
              "$ref": "#/$defs/topic_storage"
            },
            {
              "$ref": "#/$defs/topics_list"
            },
            {
              "$ref": "#/$defs/topic_get"
            },
            {
              "$ref": "#/$defs/topic_create"
            },
            {
              "$ref": "#/$defs/topic_policy"
            },
            {
              "$ref": "#/$defs/topic_delete"
            },
            {
              "$ref": "#/$defs/peers_list"
            },
            {
              "$ref": "#/$defs/peer_set"
            },
            {
              "$ref": "#/$defs/peer_delete"
            },
            {
              "$ref": "#/$defs/peer_disable"
            },
            {
              "$ref": "#/$defs/peer_certificate_revoke"
            },
            {
              "$ref": "#/$defs/peer_certificates_list"
            }
          ]
        }
      },
      "required": [
        "version",
        "command"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "version",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "detail"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "ok",
        "error"
      ],
      "additionalProperties": false
    },
    "content_save": {
      "type": "object",
      "properties": {
        "op": {
          "const": "content_save"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "topic_storage": {
      "type": "object",
      "properties": {
        "op": {
          "const": "topic_storage"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "storage": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "manual"
                },
                "encrypted": {
                  "type": "boolean"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "interval"
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2592000
                },
                "encrypted": {
                  "type": "boolean"
                }
              },
              "required": [
                "mode",
                "seconds"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "op",
        "topic",
        "storage"
      ],
      "additionalProperties": false
    },
    "topics_list": {
      "type": "object",
      "properties": {
        "op": {
          "const": "topics_list"
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "topic_get": {
      "type": "object",
      "properties": {
        "op": {
          "const": "topic_get"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "op",
        "topic"
      ],
      "additionalProperties": false
    },
    "topic_create": {
      "type": "object",
      "properties": {
        "op": {
          "const": "topic_create"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "type": "object",
          "properties": {
            "default_ttl_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            },
            "max_ttl_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            }
          },
          "required": [
            "default_ttl_seconds",
            "max_ttl_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "op",
        "topic",
        "policy"
      ],
      "additionalProperties": false
    },
    "topic_policy": {
      "type": "object",
      "properties": {
        "op": {
          "const": "topic_policy"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "type": "object",
          "properties": {
            "default_ttl_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            },
            "max_ttl_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            }
          },
          "required": [
            "default_ttl_seconds",
            "max_ttl_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "op",
        "topic",
        "policy"
      ],
      "additionalProperties": false
    },
    "topic_delete": {
      "type": "object",
      "properties": {
        "op": {
          "const": "topic_delete"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "op",
        "topic"
      ],
      "additionalProperties": false
    },
    "peers_list": {
      "type": "object",
      "properties": {
        "op": {
          "const": "peers_list"
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "peer_set": {
      "type": "object",
      "properties": {
        "op": {
          "const": "peer_set"
        },
        "peer": {
          "type": "object",
          "properties": {
            "service_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "certificate_identity": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            }
          },
          "required": [
            "service_id",
            "topics"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "op",
        "peer"
      ],
      "additionalProperties": false
    },
    "peer_delete": {
      "type": "object",
      "properties": {
        "op": {
          "const": "peer_delete"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "op",
        "service_id"
      ],
      "additionalProperties": false
    },
    "peer_disable": {
      "type": "object",
      "properties": {
        "op": {
          "const": "peer_disable"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "service_id",
        "disabled"
      ],
      "additionalProperties": false
    },
    "peer_certificate_revoke": {
      "type": "object",
      "properties": {
        "op": {
          "const": "peer_certificate_revoke"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9+/]{43}=$"
        }
      },
      "required": [
        "op",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "peer_certificates_list": {
      "type": "object",
      "properties": {
        "op": {
          "const": "peer_certificates_list"
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[A-Za-z0-9+/]{43}=$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    }
  }
}
