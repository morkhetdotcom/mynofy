{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mynofy event catalog metadata",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "state": {
      "type": "string"
    },
    "reserved_invalid_id": {
      "type": "integer"
    },
    "source": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "names": {
          "type": "string"
        },
        "numeric_ids": {
          "type": "string"
        },
        "provider_strings_sha256": {
          "type": "string"
        },
        "types_sha256": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "names",
        "numeric_ids",
        "provider_strings_sha256",
        "types_sha256"
      ],
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "parameter_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "id",
          "name",
          "value_bytes"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_parameters": {
          "type": "integer",
          "minimum": 1
        },
        "max_parameter_value_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_opaque_payload_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_parameters",
        "max_parameter_value_bytes",
        "max_opaque_payload_bytes"
      ],
      "additionalProperties": false
    },
    "catalog_id": {
      "const": 1
    }
  },
  "required": [
    "name",
    "version",
    "state",
    "source",
    "reserved_invalid_id",
    "categories",
    "actions",
    "statuses",
    "parameter_types",
    "limits",
    "catalog_id"
  ],
  "additionalProperties": false
}
