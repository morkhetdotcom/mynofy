{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mynofy v1 service links, routing and owner tunnels",
  "description": "CA/mTLS control link and bounded binary channels; client_tunnel selects end-to-end owner TLS. See docs/service-network.md.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "service_hello"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "service_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "type",
        "id",
        "service_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "service_welcome"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "service_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "type",
        "request_id",
        "service_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "enum": [
            "invalid_frame",
            "unsupported_version",
            "identity_mismatch",
            "peer_not_allowed",
            "duplicate_service",
            "handshake_required",
            "handshake_timeout",
            "internal_error",
            "rate_limited",
            "owner_unavailable",
            "route_conflict"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Bei rate_limited erforderliche Wartezeit; in der Zustandsvalidierung pr\u00fcfen."
        },
        "channel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "version",
        "type",
        "code",
        "detail"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "route_query"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "visited": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "version",
        "type",
        "id",
        "topic",
        "visited",
        "hop_limit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "route_info"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "version",
        "type",
        "request_id",
        "topic",
        "owner_id",
        "path",
        "expires_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "client_tunnel"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "version",
        "type",
        "id",
        "topic",
        "owner_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "client_tunnel_ready"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "version",
        "type",
        "request_id",
        "owner_id",
        "path",
        "expires_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "tunnel_open"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visited": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "version",
        "type",
        "channel",
        "topic",
        "owner_id",
        "visited",
        "hop_limit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "tunnel_ready"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "version",
        "type",
        "channel",
        "path",
        "expires_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "tunnel_close"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "version",
        "type",
        "channel"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "tunnel_credit"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "version",
        "type",
        "channel"
      ],
      "additionalProperties": false
    }
  ]
}
